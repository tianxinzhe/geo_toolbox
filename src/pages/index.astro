---
/**
 * 根路径 `/` —— 同时承担三个职责（技术方案 5.2）
 *
 *   ① 语言自动检测跳转：<head> 最前的**内联同步脚本**，读 localStorage
 *      与 navigator.languages，匹配后 location.replace()（不污染历史）
 *   ② 爬虫可索引：页面本身包含真实内容 —— 站名、一句话定位、
 *      **各语言的完整工具链接列表**。不是空白跳转页
 *   ③ hreflang 中枢：x-default 指向 `/`，并 alternate 到各语言首页
 *
 * 三条硬规则（PRD FR-08）：
 *   1. 带 `/{lang}/` 前缀的 URL **绝不跳转** —— 本脚本只存在于根路径
 *   2. localStorage 中的用户选择优先级最高
 *   3. <noscript> 提供各语言链接兜底
 *
 * 这个页面不复用 Base.astro：它没有单一 lang，且必须在任何渲染之前
 * 就完成跳转判断，结构越简单越好。
 */
import { DEFAULT_LANG, LAUNCHED, LOCALE } from '../config/i18n'
import { site } from '../config/site'
import { CATEGORY_META, TOOLS } from '../i18n/tools'
import { absolute, homePath, toolPath } from '../lib/paths'

// 构建期常量注入内联脚本：只有已上线语言才是合法跳转目标
const launched = JSON.stringify(LAUNCHED)
const defaultLang = JSON.stringify(DEFAULT_LANG)

// 按分类分组，供各语言的工具链接列表使用
const groups = TOOLS.reduce<Record<string, typeof TOOLS>>((acc, t) => {
  ;(acc[t.category] ??= []).push(t)
  return acc
}, {})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <script is:inline define:vars={{ launched, defaultLang }}>
      // ⚠️ 必须在 <head> 最前同步执行：跳转发生在本页任何绘制之前，
      //    因此不产生 CLS，也不会让用户看到一闪而过的错误语言。
      ;(function () {
        try {
          // ① localStorage 中的用户选择优先级最高（FR-08）
          var saved = localStorage.getItem('geo-lang')
          if (saved && launched.indexOf(saved) !== -1) {
            location.replace('/' + saved + '/')
            return
          }
          // ② 浏览器语言偏好
          var prefs = navigator.languages || [navigator.language || '']
          for (var i = 0; i < prefs.length; i++) {
            var main = String(prefs[i]).toLowerCase().split('-')[0]
            if (launched.indexOf(main) !== -1) {
              location.replace('/' + main + '/')
              return
            }
          }
        } catch (e) {
          /* 隐私模式下 localStorage 可能抛异常；失败则停留本页，
             用户仍能从下方的语言链接手动进入 */
        }
        // ③ 都不匹配则回退默认语言
        location.replace('/' + defaultLang + '/')
      })()
    </script>

    <title>{site.name.en} — {site.tagline.en}</title>
    <meta name="description" content={site.tagline.en} />
    <link rel="canonical" href={absolute(site.url, '/')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* hreflang 中枢：各语言首页 + x-default 指向根路径本身 */}
    {LAUNCHED.map((l) => <link rel="alternate" hreflang={l} href={absolute(site.url, homePath(l))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(site.url, '/')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name.en} />
    <meta property="og:title" content={`${site.name.en} — ${site.tagline.en}`} />
    <meta property="og:description" content={site.tagline.en} />
    <meta property="og:url" content={absolute(site.url, '/')} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.name.en,
      url: absolute(site.url, '/'),
      description: site.tagline.en,
      publisher: { '@type': 'Organization', name: site.name.en }
    })} />

    <style>
      :root {
        --bg: #ffffff;
        --bg-sub: #f7f8fa;
        --ink: #1a1d21;
        --ink-2: #5c636e;
        --line: #e4e7eb;
        --acc: #2563eb;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #14161a;
          --bg-sub: #1b1e24;
          --ink: #e6e8ec;
          --ink-2: #9aa1ac;
          --line: #2c313a;
          --acc: #5b8def;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font:
          15px/1.65 -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          'PingFang SC',
          'Hiragino Sans',
          'Yu Gothic',
          'Microsoft YaHei',
          sans-serif;
        padding: 32px 16px 64px;
      }
      main {
        max-width: 720px;
        margin: 0 auto;
      }
      h1 {
        font-size: 28px;
        line-height: 1.3;
        font-weight: 650;
        margin: 0 0 8px;
      }
      h2 {
        font-size: 20px;
        line-height: 1.4;
        margin: 40px 0 12px;
      }
      h3 {
        font-size: 15px;
        margin: 20px 0 6px;
        color: var(--ink-2);
        font-weight: 600;
      }
      p {
        margin: 0 0 16px;
        color: var(--ink-2);
      }
      a {
        color: var(--acc);
      }
      ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 8px;
      }
      li a {
        display: block;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 8px;
        text-decoration: none;
      }
      li a:hover {
        border-color: var(--acc);
      }
      li b {
        display: block;
        color: var(--ink);
        font-weight: 600;
      }
      li span {
        display: block;
        font-size: 12px;
        color: var(--ink-2);
        margin-top: 2px;
      }
      .langs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 32px;
        padding: 0;
        list-style: none;
      }
      .langs a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 8px 14px;
        border: 1px solid var(--line);
        border-radius: 6px;
        text-decoration: none;
        font-weight: 550;
      }
      .langs a:hover {
        border-color: var(--acc);
      }
      .notice {
        background: var(--bg-sub);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 10px 12px;
        font-size: 12px;
        color: var(--ink-2);
      }
    </style>
  </head>

  <body>
    <main>
      {/* 无 JS 或跳转失败时的兜底入口（FR-08 硬规则 3） */}
      <noscript>
        <p class="notice">
          Automatic language detection needs JavaScript. Pick your language below — every tool
          works without it.
        </p>
      </noscript>

      <ul class="langs">
        {
          LAUNCHED.map((l) => (
            <li>
              <a href={homePath(l)} lang={LOCALE[l]} hreflang={l}>
                {l === 'zh' ? '简体中文' : l === 'ja' ? '日本語' : 'English'}
              </a>
            </li>
          ))
        }
      </ul>

      <h1>{site.name.en}</h1>
      <p>{site.tagline.en}</p>
      <p class="notice">{site.tagline.zh}</p>

      {/*
        真实内容：各语言的完整工具链接列表。
        这不是为了好看 —— 根路径权重最高，必须让爬虫从这里发现全部工具页，
        而不是只看到一个空白跳转页（技术方案 5.2 职责②）。
      */}
      {
        LAUNCHED.map((l) => (
          <section lang={LOCALE[l]}>
            <h2>
              {l === 'zh' ? '全部工具' : 'All tools'} · <a href={homePath(l)}>{l === 'zh' ? '简体中文首页' : 'English home'}</a>
            </h2>
            {Object.entries(groups).map(([cat, tools]) => (
              <>
                <h3>{CATEGORY_META[cat as keyof typeof CATEGORY_META].names[l]}</h3>
                <ul>
                  {tools.map((tool) => (
                    <li>
                      <a href={toolPath(l, tool.slug)}>
                        <b>
                          {tool.id} · {tool.names[l]}
                        </b>
                        <span>{tool.desc[l]}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ))}
          </section>
        ))
      }
    </main>
  </body>
</html>
