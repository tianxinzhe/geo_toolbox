---
/**
 * 免责声明（FR-10）—— 计算结果的精度与适用性说明。不投放广告。
 *
 * 必须明确：「本站结果不构成测绘、国土、工程等法定用途的依据，
 * 正式成果请使用具备资质的工具与流程」，以及第三方数据署名与版权归属。
 */
import { LAUNCHED, type Lang } from '../../../config/i18n'
import { t } from '../../../i18n/ui'
import { legalPath } from '../../../lib/paths'
import ContentPage from '../../../layouts/ContentPage.astro'

export function getStaticPaths() {
  return [...LAUNCHED].map((lang) => ({ params: { lang }, props: { lang } }))
}

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const slug = 'disclaimer' as const
---

<ContentPage
  lang={lang}
  path={legalPath(lang, slug)}
  title={t(lang, 'nav.disclaimer')}
  description={t(lang, 'nav.disclaimer')}
  h1={t(lang, 'nav.disclaimer')}
  doc={{ collection: 'legal', slug }}
  ads={false}
  anchor={false}
/>
