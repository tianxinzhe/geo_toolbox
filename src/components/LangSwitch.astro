---
/**
 * 语言切换器（FR-08）
 *
 * 规则：
 * 1. 只渲染 LAUNCHED 中的语言 —— 未上线的语言没有对应 HTML，
 *    渲染出来会产生死链，check-hreflang 会 fail。改 config/i18n.ts 的
 *    LAUNCHED 一行，这里自动增删。
 * 2. 切换到**同一页面**的另一语言版本，并保留当前输入值与全部选项
 *    （通过 URL 参数透传，FR-05）。无 JS 时退化为纯路径切换，功能不受损。
 * 3. 语言自称不翻译（简体中文 / English / 日本語），用户在任何界面语言下
 *    都能认出自己的语言。
 * 4. 全部是真实 <a href>，不是 <div onclick>（SR-12 硬规则 1）。
 */
import { LABEL, LAUNCHED, type Lang } from '../config/i18n'
import { t } from '../i18n/ui'
import { swapLang } from '../lib/paths'

interface Props {
  lang: Lang
  path: string
}

const { lang, path } = Astro.props

const targets = LAUNCHED.map((to) => ({
  to,
  label: LABEL[to],
  href: to === lang ? path : swapLang(path, to)
}))
---

<nav class="lang-switch" aria-label={t(lang, 'a11y.langSwitch')}>
  {
    targets.map((item) => (
      <a
        href={item.href}
        lang={item.to}
        hreflang={item.to}
        data-lang-link
        aria-current={item.to === lang ? 'true' : undefined}
      >
        {item.label}
      </a>
    ))
  }
</nav>

<script>
  // 保留当前 URL 的查询参数（FR-05 / FR-08：切换语言不丢失输入状态）。
  // 无 JS 时链接仍可用，只是不带参数 —— 渐进增强。
  const search = globalThis.location?.search ?? ''
  if (search) {
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]')) {
      // 只给同页面链接补参数，不污染已有的 hash（如首页的 #tools 锚点）
      const url = new URL(a.getAttribute('href') ?? '', globalThis.location.origin)
      if (!url.search) {
        url.search = search
        a.setAttribute('href', url.pathname + url.search + url.hash)
      }
    }
  }
</script>
