---
/**
 * 面包屑（FR-03：所有工具页必须存在；带层级结构化数据）
 *
 * 只提供返回分类页的入口 —— 让用户能回到同类工具的聚合页，
 * 同时给分类页传递内链权重。
 *
 * 全部是真实 <a href>（SR-12 硬规则 1）。
 * 最后一项是当前页，用 aria-current="page" 标注且不带链接。
 *
 * 对应的 BreadcrumbList JSON-LD 由调用方通过 lib/seo.ts 生成后传给 Base，
 * 因为 JSON-LD 必须在 <head> 中。
 */
import type { Crumb } from '../lib/seo'

interface Props {
  crumbs: Crumb[]
  /** aria-label，由调用方传入已翻译文案 */
  label: string
}

const { crumbs, label } = Astro.props
---

<nav class="breadcrumb" aria-label={label}>
  <ol>
    {
      crumbs.map((c, i) => (
        <li>
          {c.href && i < crumbs.length - 1 ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span aria-current="page">{c.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
