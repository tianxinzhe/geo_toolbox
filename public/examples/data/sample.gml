      <app:geom><gml:Polygon srsName="EPSG:4326"><gml:exterior><gml:LinearRing><gml:posList>-73.9864 40.7572 -73.9846 40.7572 -73.9846 40.7586 -73.9864 40.7586 -73.9864 40.7572</gml:posList></gml:LinearRing></gml:exterior></gml:Polygon></app:geom>
