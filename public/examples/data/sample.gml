<?xml version="1.0" encoding="UTF-8"?>
<gml:FeatureCollection xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:app="urn:geotoolbox">
  <gml:featureMember>
    <app:poi>
      <app:name>Times Square</app:name>
      <app:kind>poi</app:kind>
      <app:geom><gml:Point srsName="EPSG:4326"><gml:pos>-73.9855 40.758</gml:pos></gml:Point></app:geom>
    </app:poi>
  </gml:featureMember>
  <gml:featureMember>
    <app:line>
      <app:name>Walk</app:name>
