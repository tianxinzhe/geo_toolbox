{
  "name": "geo-toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "地理工具箱 · 纯静态、全本地计算的地理信息工具矩阵站",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "tsx scripts/check-i18n.ts && tsx scripts/verify-epsg.ts",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:epsg": "tsx scripts/verify-epsg.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/vue": "^5.0.0",
    "@geoman-io/leaflet-geoman-free": "^2.20.6",
    "@placemarkio/tokml": "^0.4.0",
    "@tmcw/togeojson": "^7.1.3",
    "@turf/buffer": "^7.4.0",
    "astro": "^5.0.0",
    "epsg": "^0.5.0",
    "fflate": "^0.8.3",
    "flatgeobuf": "^4.6.1",
    "leaflet": "^1.9.4",
    "papaparse": "^5.7.0",
    "polygon-clipping": "^0.15.7",
    "proj4": "^2.22.0",
    "shpjs": "^6.2.0",
    "sql.js": "^1.15.2",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "vue": "^3.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/sql.js": "^1.4.11",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "epsg-index": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
